# Root .gitignore for GNN repository

# Python Virtual Environments
.venv311/
.venv/
venv/
ENV/
env/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Testing & Caches
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# IDE & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
.env

# Raw Datasets, Caches and Phase 1 Scratch
data/
"Phase 1/"
Phase 1/
crystal_gnn/data/cache/
crystal_gnn/data/raw/

# Temporary logs and scratch execution outputs
*.log
scratch/
comformer_check_structures/
crystal_gnn/comformer_check_structures/

# Checkpoint binaries (ignored for Git to stay below GitHub's 100MB file limit)
checkpoints/
crystal_gnn/checkpoints/
*.pt
*.pth

# Results
results/*
crystal_gnn/results/*
!results/*.csv
!crystal_gnn/results/*.csv
