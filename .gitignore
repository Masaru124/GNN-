# Root .gitignore for GNN repository

# Python Virtual Environments
.venv311/
.venv/
venv/
ENV/
env/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Testing & Caches
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# IDE & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
.env

# Raw Datasets & Cache Dumps (root level only, do NOT ignore crystal_gnn/crystal_gnn/data source code!)
/data/
/Phase 1/
Phase 1/
crystal_gnn/data/cache/
crystal_gnn/data/raw/

# Explicitly track crystal_gnn Python package data module
!crystal_gnn/crystal_gnn/data/
!crystal_gnn/crystal_gnn/data/*.py

# Temporary logs and scratch execution outputs
*.log
scratch/
comformer_check_structures/
crystal_gnn/comformer_check_structures/

# Checkpoint binaries (ignore large training checkpoints, allow lightweight inference weights)
checkpoints/
crystal_gnn/checkpoints/
*.pt
*.pth
!crystal_gnn/model_inference.pt
!model_inference.pt
qe_download.zip

# Results
results/*
crystal_gnn/results/*
!results/*.csv
!crystal_gnn/results/*.csv

# Copyrighted literature PDFs and raw text dumps
*.pdf
research/literature/pdfs/
materials-screening-ai/research/literature/pdfs/
combined.md
combined research paper.pdf
materials-screening-ai/research/literature/combined.md

# Agent directories and customizations
.agents/
**/.agents/

# Graphify generated index and cache
graphify-out/

# Skills lock file (generated)
skills-lock.json

.freebuff/

# Scratch / build leftovers
scratch_dft_test/
*.egg-info/
input_tmp.in
# Local database backups (untracked, not reproducible from git)
local_backups/

# Local MLflow tracking db created by crystal_gnn/scripts/train.py
crystal_gnn/mlflow.db
crystal_gnn/mlruns/

# LOCO scheduler runtime state (power-cut resume; regenerate by rerunning)
crystal_gnn/.loco_scheduler_state.json
crystal_gnn/.loco_scheduler.lock
crystal_gnn/loco_scheduler.log
crystal_gnn/loco_scheduler_bg.out
crystal_gnn/loco_scheduler_bg.err
