&CONTROL
   calculation      = 'nscf'
   restart_mode     = 'from_scratch'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = 'c:/Users/User/Desktop/GNN/scratch_dft_test/scf_out'
   prefix           = 'matscreen'
   pseudo_dir       = 'c:/Users/User/Desktop/GNN/qe/pseudo'
/
&SYSTEM
   ecutwfc          = 60.0
   ecutrho          = 480.0
   occupations      = 'tetrahedra'
   degauss          = 0.01
   smearing         = 'mv'
   ntyp             = 2
   nat              = 2
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-08
/
&IONS
   ion_dynamics     = 'bfgs'
/
&CELL
   cell_dynamics    = 'bfgs'
   press_conv_thr   = 0.5
/
&FCP
/
&RISM
/
